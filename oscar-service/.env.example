# Переменные окружения oscar-service.
# Скопируйте в .env (или задайте в окружении/IDE/docker-compose) и подставьте реальные значения.
OSCAR_DB_URL=jdbc:postgresql://localhost:5432/oscar
OSCAR_DB_USERNAME=oscar
OSCAR_DB_PASSWORD=oscar

# Базовый URL первого сервиса (movie-service) для межсервисного вызова.
MOVIE_SERVICE_URL=http://localhost:8080