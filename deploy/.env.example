# Лаба №3: Spring Cloud-стек (config/eureka/gateway/haproxy/oscar x2/frontend).
# Скопируйте в .env и при необходимости переопределите значения.
#   cp .env.example .env

# --- PostgreSQL ---
DB_USERNAME=soa
DB_PASSWORD=change-me

# --- Сертификаты (deploy/gen-certs.sh) ---
# Пароль keystore/truststore gateway и p12-файлов.
KEYSTORE_PASSWORD=changeit

# --- Порты, публикуемые на хост ---
# API Gateway (Zuul, HTTPS) — единственная входная точка API.
GATEWAY_PORT=8443
# Frontend (nginx, HTTPS + same-origin проксирование на gateway).
FRONTEND_PORT=8444
# Eureka Server (нужен инфраструктурным тестам).
EUREKA_PORT=8761
# Config Server (нужен инфраструктурным тестам).
CONFIG_PORT=8888
# HAProxy stats-страница (http://localhost:8404/stats).
HAPROXY_STATS_PORT=8404

# --- CORS ---
# Ориджин браузера — фронтенд (same-origin проксирование всё равно работает,
# но CORS-заголовки сервисов должны разрешать фронт).
CORS_ALLOWED_ORIGINS=https://localhost:8444

# --- JVM-опции (передаются через _JAVA_OPTIONS, согласованы с mem_limit) ---
CONFIG_JAVA_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=192m
EUREKA_JAVA_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=192m
MOVIE_JAVA_OPTIONS=-Xmx512m -XX:MaxMetaspaceSize=320m
OSCAR_JAVA_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=256m
GATEWAY_JAVA_OPTIONS=-Xmx384m

# --- Vite-сборка фронтенда ---
# Фронт ходит на API same-origin через nginx-проксирование, поэтому базовые пути
# относительные. Сборка: VITE_MOVIE_API=/movie-service VITE_OSCAR_API=/oscar npm --prefix frontend run build
